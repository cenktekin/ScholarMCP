# ScholarMCP environment template
# Kopyala: cp .env.example .env   (değerler config.ts'teki varsayılanlardır)
# Gerçek anahtarları .env dosyasına yaz — .env git'e girmez, bu şablon girer.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Server kimliği --------------------------------------------------------
SCHOLAR_MCP_SERVER_NAME=scholar-mcp
# Boş bırakılırsa packages/scholar-mcp/package.json sürümü kullanılır
# SCHOLAR_MCP_SERVER_VERSION=

# --- Transport -------------------------------------------------------------
# stdio | http | both
SCHOLAR_MCP_TRANSPORT=stdio
SCHOLAR_MCP_HOST=127.0.0.1
SCHOLAR_MCP_PORT=3000
SCHOLAR_MCP_ENDPOINT_PATH=/mcp
SCHOLAR_MCP_HEALTH_PATH=/health

# --- HTTP oturum yönetimi --------------------------------------------------
# stateful | stateless
SCHOLAR_MCP_HTTP_SESSION_MODE=stateful
SCHOLAR_MCP_HTTP_SESSION_TTL_MS=1800000
SCHOLAR_MCP_HTTP_MAX_SESSIONS=200

# Yalnızca http/both modunda gerekli. Virgülle ayrılmış liste.
# SCHOLAR_MCP_ALLOWED_ORIGINS=
# SCHOLAR_MCP_ALLOWED_HOSTS=
# SCHOLAR_MCP_API_KEY=

# --- Google Scholar scrape -------------------------------------------------
SCHOLAR_BASE_URL=https://scholar.google.com
SCHOLAR_LANGUAGE=en
SCHOLAR_TIMEOUT_MS=15000
SCHOLAR_RETRY_ATTEMPTS=2
SCHOLAR_RETRY_DELAY_MS=800
SCHOLAR_REQUEST_DELAY_MS=250
SCHOLAR_MAX_RESULTS_PER_REQUEST=20

# --- Araştırma sağlayıcıları ----------------------------------------------
RESEARCH_OPENALEX_BASE_URL=https://api.openalex.org
# RESEARCH_OPENALEX_API_KEY=
RESEARCH_CROSSREF_BASE_URL=https://api.crossref.org
RESEARCH_SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
# Anahtar yoksa Semantic Scholar düşük hız limitine tabidir
# RESEARCH_SEMANTIC_SCHOLAR_API_KEY=

RESEARCH_TIMEOUT_MS=20000
RESEARCH_RETRY_ATTEMPTS=2
RESEARCH_RETRY_DELAY_MS=800
RESEARCH_REQUEST_DELAY_MS=100

# --- PDF ingestion ---------------------------------------------------------
RESEARCH_ALLOW_REMOTE_PDFS=true
RESEARCH_ALLOW_LOCAL_PDFS=true
# GROBID çalışmıyorsa boş bırak; PDF ayrıştırma pdf-parse'a düşer
# RESEARCH_GROBID_URL=http://localhost:8070

# --- Semantik çıkarım ------------------------------------------------------
# cloud-llm | none
RESEARCH_SEMANTIC_ENGINE=cloud-llm
RESEARCH_CLOUD_MODEL=gpt-4.1-mini

# --- Graf önbelleği --------------------------------------------------------
RESEARCH_GRAPH_CACHE_TTL_MS=300000
RESEARCH_GRAPH_MAX_CACHE_ENTRIES=300
RESEARCH_GRAPH_PROVIDER_RESULT_MULTIPLIER=2
RESEARCH_GRAPH_FUZZY_TITLE_THRESHOLD=0.84
